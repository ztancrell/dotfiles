# Personal additions only. openbox-autostart runs /etc/xdg/openbox/autostart (homestead-theme) first, which
# already starts polkit, the login and USB sounds, fastcompmgr, feh, tint2, dunst and the XDG autostart
# entries (dex); repeating them here would run each twice. (CachyOS version: in ~/.dotfiles history.)

# Until homestead-theme has it: give D-Bus-started services (file dialog portal) the X display.
grep -q dbus-update-activation-environment /etc/xdg/openbox/autostart || \
  dbus-update-activation-environment DISPLAY XAUTHORITY XDG_SESSION_TYPE QT_QPA_PLATFORMTHEME XCURSOR_THEME XCURSOR_SIZE

# xrandr
xrandr --output HDMI-1 --primary --pos 0x0 --mode 1920x1080 --rate 100 \
       --output DP-3 --pos 1920x0 --mode 1920x1080 --rate 60

# fastcompmgr reads the refresh rate once at start, and the system autostart starts it before the xrandr
# above, so it would pace for 60 Hz. Restart it at the 100 Hz my old setup used.
pkill -x fastcompmgr; sleep 0.3; fastcompmgr --refresh-rate 100 &

# nightlight (only if script exists)
[ -x "$HOME/redshift-cli.sh" ] && "$HOME/redshift-cli.sh" start &

# synergy (only if installed). synergy-service replaces the package's systemd user unit
# (synergy-3.service: restart on failure after 1 s); the GUI talks to it.
if [ -x /opt/Synergy/synergy ]; then
  (cd /opt/Synergy && until ./synergy-service -d; do sleep 1; done) &
  /opt/Synergy/synergy &
fi

# wallpaper: my picks instead of the whole Homestead set
feh --bg-fill --randomize -r ~/.wallpapers/artstation ~/.wallpapers/sst ~/.wallpapers/berserk

# Until homestead-theme r25 is installed: the old system autostart has no dex, so the tray applets
# would not start. Turns itself off once /etc/xdg/openbox/autostart has dex.
grep -q 'dex -a' /etc/xdg/openbox/autostart || { sleep 1; dex -a -e Openbox; } &
