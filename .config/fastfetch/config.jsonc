// Homestead fastfetch config: minimal, firebrick accent
{
  "logo": {
    "type": "builtin",
    "source": "artix_small",
    "color": { "1": "red" },
    "padding": { "right": 2 }
  },

  "display": {
    "separator": "  ",
    "key": { "width": 8 },
    "color": { "title": "red", "keys": "red" }
  },

  "modules": [
    "title",
    "break",
    { "type": "os",       "key": "os",     "format": "{name}" },
    { "type": "kernel",   "key": "kernel", "format": "{release}" },
    { "type": "uptime",   "key": "uptime" },
    { "type": "packages", "key": "pkgs",   "format": "{all}" },
    { "type": "wm",       "key": "wm",     "format": "{pretty-name}" },
    { "type": "shell",    "key": "shell",  "format": "{pretty-name}" },
    { "type": "cpu",      "key": "cpu",    "format": "{name}" },
    { "type": "gpu",      "key": "gpu",    "format": "{name}", "hideType": "integrated" },
    { "type": "memory",   "key": "mem",    "format": "{used} / {total}" },
    { "type": "disk",     "key": "disk",   "folders": ["/"], "format": "{size-used} / {size-total} ({size-percentage})" }
  ]
}
